# Copy to .env and fill in. .env is git-ignored; this file is committed and must never hold real secrets.
# In production, set these in the host's dashboard (Render / Railway), not in a file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Atlas → Connect → Drivers. Use a separate database per environment:
# /mission_control_dev locally, /mission_control in production.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/mission_control_dev?retryWrites=true&w=majority&appName=mission-control

# The web app's origin(s), comma-separated, no trailing slash. Production: https://<your-app>.vercel.app
WEB_ORIGINS=http://localhost:3000

# Base URL of the web app, for links in emails. Production: https://<your-app>.vercel.app
APP_URL=http://localhost:3000

# Leave unset when the web app forwards /api/v1 to this API (the default setup).
# Only for the custom-domain setup (app.example.com + api.example.com): .example.com
# COOKIE_DOMAIN=

# Proxies between the browser and this API, so rate limits see the real client IP.
# Local: 0. API on Vercel (also behind the web app's forwarding): 1, measured 2026-10-25. Render/Railway: 2.
TRUST_PROXY_HOPS=0

# MongoDB connections per running instance. Default: 10, or 5 on Vercel (many small instances
# share the Atlas free tier's ~500-connection limit). Usually leave unset.
# MONGODB_MAX_POOL_SIZE=
