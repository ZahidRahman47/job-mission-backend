// Used by the editor, `pnpm typecheck` and ESLint: covers source, tests, scripts and config.
// The build uses tsconfig.build.json, which compiles src only.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"]
}
